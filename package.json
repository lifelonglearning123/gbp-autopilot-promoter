{
  "name": "gbp-autopilot-promoter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "import:ghl": "dotenv -e .env.local -- tsx scripts/import-ghl.ts",
    "verify:emails": "dotenv -e .env.local -- tsx scripts/verify-emails.ts",
    "research": "dotenv -e .env.local -- tsx scripts/research.ts",
    "draft": "dotenv -e .env.local -- tsx scripts/draft.ts",
    "drafts:review": "dotenv -e .env.local -- tsx scripts/drafts-review.ts",
    "instantly:setup": "dotenv -e .env.local -- tsx scripts/instantly-setup.ts",
    "push": "dotenv -e .env.local -- tsx scripts/push.ts",
    "followups": "dotenv -e .env.local -- tsx scripts/followups.ts",
    "rewrite-first": "dotenv -e .env.local -- tsx scripts/rewrite-first.ts",
    "youtube:setup": "dotenv -e .env.local -- tsx scripts/youtube-setup.ts",
    "partners:setup": "dotenv -e .env.local -- tsx scripts/partners-setup.ts",
    "fix:countries": "dotenv -e .env.local -- tsx scripts/fix-countries.ts",
    "recheck:emails": "dotenv -e .env.local -- tsx scripts/recheck-emails.ts",
    "us:setup": "dotenv -e .env.local -- tsx scripts/us-setup.ts",
    "send-test": "dotenv -e .env.local -- tsx scripts/send-test.ts",
    "import:history": "dotenv -e .env.local -- tsx scripts/import-instantly-history.ts",
    "db:counts": "dotenv -e .env.local -- tsx scripts/db-counts.ts",
    "check:keys": "dotenv -e .env.local -- tsx scripts/check-keys.ts",
    "vercel:env": "node scripts/push-env-to-vercel.mjs",
    "platform:ping": "dotenv -e .env.local -- tsx scripts/platform-ping.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "next": "16.2.4",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
