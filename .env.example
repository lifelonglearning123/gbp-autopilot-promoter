# Copy to .env.local (never committed). In Vercel, set the same names.

# Neon Postgres: Vercel project → Storage → Create Database → Neon. Vercel adds
# DATABASE_URL to the project; copy it here for local scripts and migrations.
DATABASE_URL=

# GoHighLevel sub-account holding the agency list (contacts tagged ghl-agency).
ghl_token=
ghl_location=

# GBP Autopilot platform bot API. The key must equal BOT_API_KEY on gbp-platform.
PLATFORM_URL=https://gbp.macaws.ai
PLATFORM_BOT_API_KEY=
# Equal to BOT_WEBHOOK_SECRET on gbp-platform, whose BOT_WEBHOOK_URL is
# https://<this app>/api/platform-events
PLATFORM_WEBHOOK_SECRET=

# Coming next
OPENROUTER_API_KEY=
# Kimi direct (platform.moonshot.ai): when set, Kimi skips OpenRouter.
# Use https://api.moonshot.cn/v1 as MOONSHOT_BASE_URL for a China-region account.
MOONSHOT_API_KEY=
INSTANTLY_API_KEY=
# The workspace is shared with another client: our mailboxes carry this tag.
INSTANTLY_TAG=Signal
# Under every email (\n for a new line). SENDER_LEGAL: the company that sends, and its address.
SENDER_SIGNOFF=Chao\nFounder, GBP Autopilot
SENDER_LEGAL=
# From npm run instantly:setup (the first-email campaign, made as a draft).
INSTANTLY_CAMPAIGN_ID=
# Any long random string; Instantly sends it back on every webhook.
INSTANTLY_WEBHOOK_SECRET=
# This app's public address, once deployed (for Instantly's webhook).
APP_URL=
TRIGGER_SECRET_KEY=
